msgstr ""

#: src/Privacy/PolicyContent.php:64
msgid "Our analytics does not use cookies at all, and stores nothing on your device. There is nothing to opt out of, and nothing for you to dismiss."
msgstr ""

#: src/Privacy/PolicyContent.php:68
