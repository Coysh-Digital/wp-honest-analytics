{
    "name": "coysh-digital/honest-analytics",
    "description": "Privacy-first, cookieless analytics for WordPress. No third-party service, no IP addresses, no per-visitor rows.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Coysh Digital",
            "homepage": "https://coysh.digital"
        }
    ],
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.1",
        "donatj/phpuseragentparser": "^1.8",
        "jaybizzle/crawler-detect": "^1.2",
        "maxmind-db/reader": "^1.11"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
        "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "HonestAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HonestAnalytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "test": [
            "@test:unit"
        ],
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=2G",
        "budgets": "php bin/check-budgets.php",
        "build": "bash bin/build-zip.sh",
        "pot": "bash bin/make-pot.sh"
    },
    "config": {
        "_comment": "platform pins resolution to the lowest supported PHP, so a machine running 8.4 cannot pull a dependency that the 8.1 floor cannot parse.",
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
